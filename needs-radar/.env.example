# 复制为 .env 并填入，本地运行时 source 一下；GitHub Actions 里配成 repo secrets
ANTHROPIC_API_KEY=sk-ant-xxx
RESEND_API_KEY=re_xxx
# Reddit OAuth（匿名 JSON 已被 403，需在 https://www.reddit.com/prefs/apps 建免费 script app）
REDDIT_CLIENT_ID=xxx
REDDIT_CLIENT_SECRET=xxx
# v0.2 竞品核查，二选一（都不填则跳过核查）：
# Serper.dev 注册送 2500 次；SerpAPI(serpapi.com) 免费 100 次/月（用它时把 config 的 max_searches_per_day 调到 3）
SERPER_API_KEY=xxx
SERPAPI_API_KEY=xxx
